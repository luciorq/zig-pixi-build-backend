.{
    // The backend reads .name/.version from here when [package] in
    // pixi.toml omits them (fingerprint checksum = crc32 of the name).
    .name = .hello_zig,
    .version = "0.2.0",
    .fingerprint = 0x1c1a468600000001,
    .minimum_zig_version = "0.14.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
